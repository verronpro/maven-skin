#parse( "site-macros.vm" )
#parse( "toc-macros.vm" )
<!DOCTYPE html>
<!-- Generated by Apache Maven Doxia Site Renderer#if( $doxiaSiteRendererVersion ) $doxiaSiteRendererVersion#end##
#if( $docRenderingContext.generator || $docRenderingContext.doxiaSource ) from##
    #if( $docRenderingContext.generator ) $docRenderingContext.generator#end##
    #if( $docRenderingContext.doxiaSource ) $docRenderingContext.doxiaSourcePath#end##
#end
 at $date -->
<html#if ( $locale ) lang="$locale.language"#end>
<head>
    <meta charset="$outputEncoding"/>
    <script>
        (function () {
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>$title</title>
    #if( $project.description )
        #set( $cleanDesc = $project.description.replaceAll(
            '[\r\n]+', ' ').replace('"', '').trim() )
        <meta name="description" content="$cleanDesc"/>
    #end
    <link rel="stylesheet" href="$relativePath/css/stylesheet.css"
          type="text/css" media="all"/>
    #foreach( $author in $authors )
        <meta name="author" content="$author"/>
    #end
    #if ( $documentDate )
        <meta name="date" content="$documentDate"/>
    #end
    #if ( $locale )
        <meta http-equiv="Content-Language" content="$locale.language"/>
    #end
    #set( $faviconEl = $decoration.custom.getChild( 'favicon' ) )
    #if( $faviconEl )
        <link rel="icon" href="$relativePath/$faviconEl.getValue()"/>
    #end
    #if( $decoration.body.head )
        $render.eval( $decoration.body.head )
    #end
    $!headContent
    #googleAnalytics()
    #ahrefsAnalytics()
    #diagramScripts()
    <script defer src="$relativePath/js/toc-generator.js"></script>
    #openGraph()
</head>
<body class="layout-doc">
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" role="banner">
    <div class="container-wide site-header__inner">
        <a class="site-header__brand" href="$relativePath/index.html">
            #set( $logoEl = $decoration.custom.getChild( 'logo' ) )
            #if( $logoEl )
                #set( $logoSrc = $logoEl.getValue() )
                #if( !$decoration.isLink( $logoSrc ) )
                    #set( $logoSrc = $PathTool.calculateLink( $logoSrc, $relativePath ).replaceAll(
                        '\\', '/' ) )
                #end
                <span class="logo" aria-hidden="true"><img src="$logoSrc"
                                                           alt=""/></span>
            #elseif( $decoration.bannerLeft && $decoration.bannerLeft.src )
                #set( $bSrc = $decoration.bannerLeft.src )
                #if( !$decoration.isLink( $bSrc ) )
                    #set( $bSrc = $PathTool.calculateLink( $bSrc, $relativePath ).replaceAll(
                        '\\', '/' ) )
                #end
                <span class="logo" aria-hidden="true"><img src="$bSrc" alt=""/></span>
            #end
            <span>#if( $decoration.bannerLeft && $decoration.bannerLeft.name )$decoration.bannerLeft.name#else$project.name#end</span>
        </a>
        <nav class="site-header__nav" aria-label="Primary">
            #headerLinks( $decoration.body.links )
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
                <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
