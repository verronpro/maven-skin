#parse( "site-macros.vm" )
#parse( "toc-macros.vm" )
<!DOCTYPE html>
<!-- Generated by Apache Maven Doxia Site Renderer#if( $doxiaSiteRendererVersion ) $doxiaSiteRendererVersion#end##
#if( $docRenderingContext.generator || $docRenderingContext.doxiaSource ) from##
    #if( $docRenderingContext.generator ) $docRenderingContext.generator#end##
    #if( $docRenderingContext.doxiaSource ) $docRenderingContext.doxiaSourcePath#end##
#end
 at $date -->
<html#if ( $locale ) lang="$locale.language"#end>
<head>
    <meta charset="$outputEncoding"/>
    <script>
        (function () {
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>$title</title>
    #if( $project.description )
        #set( $cleanDesc = $project.description.replaceAll(
            '[\r\n]+', ' ').replace('"', '').trim() )
        <meta name="description" content="$cleanDesc"/>
    #end
    <link rel="stylesheet" href="$relativePath/css/stylesheet.css"
          type="text/css" media="all"/>
    #foreach( $author in $authors )
        <meta name="author" content="$author"/>
    #end
    #if ( $documentDate )
        <meta name="date" content="$documentDate"/>
    #end
    #if ( $locale )
        <meta http-equiv="Content-Language" content="$locale.language"/>
    #end
    #set( $faviconEl = $decoration.custom.getChild( 'favicon' ) )
    #if( $faviconEl )
        <link rel="icon" href="$relativePath/$faviconEl.getValue()"/>
    #end
    #if( $decoration.body.head )
        $render.eval( $decoration.body.head )
    #end
    $!headContent
    #googleAnalytics()
    #ahrefsAnalytics()
    #diagramScripts()
    <script defer src="$relativePath/js/toc-generator.js"></script>
    #openGraph()
</head>
<body class="layout-doc">
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" role="banner">
    <div class="container-wide site-header__inner">
        <a class="site-header__brand" href="$relativePath/index.html">
            #set( $logoEl = $decoration.custom.getChild( 'logo' ) )
            #if( $logoEl )
                #set( $logoSrc = $logoEl.getValue() )
                #if( !$decoration.isLink( $logoSrc ) )
                    #set( $logoSrc = $PathTool.calculateLink( $logoSrc, $relativePath ).replaceAll(
                        '\\', '/' ) )
                #end
                <span class="logo" aria-hidden="true"><img src="$logoSrc"
                                                           alt=""/></span>
            #elseif( $decoration.bannerLeft && $decoration.bannerLeft.src )
                #set( $bSrc = $decoration.bannerLeft.src )
                #if( !$decoration.isLink( $bSrc ) )
                    #set( $bSrc = $PathTool.calculateLink( $bSrc, $relativePath ).replaceAll(
                        '\\', '/' ) )
                #end
                <span class="logo" aria-hidden="true"><img src="$bSrc" alt=""/></span>
            #end
            <span>#if( $decoration.bannerLeft && $decoration.bannerLeft.name )$decoration.bannerLeft.name#else$project.name#end</span>
        </a>
        <nav class="site-header__nav" aria-label="Primary">
            #headerLinks( $decoration.body.links )
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
                <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 00-1.41 0 .996.996 0 000 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 000-1.41.996.996 0 00-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"/>
                </svg>
                <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m 6.835,-2.5814226 c 0,7.55 5.179,13.6699996 11.567,13.6699996 1.588,0 3.101,-0.38 4.479,-1.063 -1.695,4.46 -5.996,7.636 -11.051,7.636 -6.533,0 -11.83,-5.297 -11.83,-11.8299996 0,-4.82 2.888,-8.959 7.023,-10.803 -0.116,0.778 -0.188,1.573 -0.188,2.39 z"/>
                </svg>
            </button>
        </nav>
    </div>
</header>

<main id="main" class="container-wide" style="padding: 1rem 0 2rem">
    #if ( $decoration.body.breadcrumbs && $decoration.body.breadcrumbs.size() > 0 )
        <nav class="breadcrumbs" aria-label="Breadcrumb">
            #breadcrumbs( $decoration.body.breadcrumbs )
        </nav>
    #end
    <div class="home-grid">
        <article class="home-main post-content">
            $bodyContent
            #if( $decoration.edit && $docRenderingContext.editable )
                #set( $editUrl = $docRenderingContext.getDoxiaSourcePath( $decoration.edit ).replaceFirst(
                    "\.git/", "/blob/main/" ) )
                <div class="post-edit-link">
                    <a href="$editUrl">Edit this page</a>
                </div>
            #end
        </article>
        <aside class="home-sidebar" aria-label="Sidebar">
            <nav class="card sidebar-menu" aria-label="table of contents">
                <ul class="sidebar-nav">
                    #setupTableOfContents({'minHeadings': 2})
                </ul>
            </nav>
            #mainMenu( $decoration.body.menus )
            #publishVersionCard()
        </aside>
    </div>
</main>

<footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner container-wide">
        <div>
            <strong>$project.name</strong>
            #if( $project.description )
                <p class="muted">$project.description</p>
            #end
        </div>
        #if( $decoration.body.footer )
            <div class="site-footer__custom">$render.eval( $decoration.body.footer )</div>
        #end
        <div class="site-footer__powered">
            <strong>Built with</strong>
            <p>#poweredByLogo( $decoration.poweredBy )</p>
        </div>
    </div>
    <div class="site-footer__bottom">
        <div class="container-wide">
            Copyright &#169;#copyright()All rights reserved.
        </div>
    </div>
</footer>
<script>
    /* Remove hardcoded inline style="background: #FFFFFF" emitted by Doxia on bodyTable elements */
    document.querySelectorAll('table.bodyTable[style]').forEach(function (t) {
        t.removeAttribute('style');
    });

    /* Theme toggle logic */
    const themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
        themeToggle.addEventListener('click', function () {
            const currentTheme = document.documentElement.getAttribute('data-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });
    }
</script>
</body>
</html>
