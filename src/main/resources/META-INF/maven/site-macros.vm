## Top-right links from <body><links> in site.xml — rendered as primary horizontal nav.
#macro ( headerLinks $links )
    #if ( $links )
        #foreach( $item in $links )
            #set ( $href = $PathTool.calculateLink( $item.href, $relativePath ).replaceAll(
                '\\', '/' ) )
            #if ( $decoration.isLink( $item.href ) )
            <a class="externalLink" href="$href"#if( $item.target )
               target="$item.target"#end>$item.name</a>
            #else
            <a href="$href">$item.name</a>
            #end
        #end
    #end
#end

## Breadcrumbs — emits a chain of links + the current page's short title.
#macro ( breadcrumbs $breadcrumbs )
    #foreach( $item in $breadcrumbs )
        #set ( $currentItemHref = $PathTool.calculateLink( $item.href, $relativePath ).replaceAll(
            '\\', '/' ) )
        #if ( ( $currentItemHref == '' ) )
            #set ( $currentItemHref = './' )
        #end
        #link( $currentItemHref $item.name $item.target $item.img $item.position $item.alt $item.border $item.width $item.height $item.title )
    &gt;
    #end
<span class="crumb-current">$shortTitle</span>
#end

## Tree walker used to decide whether a parent menu should be expanded
## (because one of its descendants is the current page).
#macro ( displayTree $display $item )
    #if ( $item && $item.items && $item.items.size() > 0 )
        #foreach( $subitem in $item.items )
            #set ( $subitemHref = $PathTool.calculateLink( $subitem.href, $relativePath ).replaceAll(
                '\\', '/' ) )
            #if ( $alignedFileName == $subitemHref )
                #set ( $display = true )
            #end
            #displayTree( $display $subitem )
        #end
    #end
#end

## Single menu item: renders <li> with `active` class when it's the current page,
## and recursively descends into nested items.
#macro ( menuItem $item )
    #set ( $collapse = "none" )
    #set ( $currentItemHref = $PathTool.calculateLink( $item.href, $relativePath ).replaceAll(
        '\\', '/' ) )

    #if ( $item && $item.items && $item.items.size() > 0 )
        #if ( $item.collapse == false )
            #set ( $collapse = "expanded" )
        #else
            #set ( $collapse = "collapsed" )
        #end
        #set ( $display = false )
        #displayTree( $display $item )
        #if ( $alignedFileName == $currentItemHref || $display )
            #set ( $collapse = "expanded" )
        #end
    #end

    #if ( $alignedFileName == $currentItemHref )

    <li class="$collapse active"><span class="active-link">$item.name</span>##
    #else

    <li class="$collapse">#link( $currentItemHref $item.name $item.target $item.img $item.position $item.alt $item.border $item.width $item.height $item.title )##
    #end
    #if ( $item && $item.items && $item.items.size() > 0 && $collapse ==
        "expanded" )
        <ul>
            #foreach( $subitem in $item.items )
        #menuItem( $subitem )
        #end
        </ul>
    #end
</li>
#end

## Renders all <menu> blocks from site.xml as a stack of sidebar cards.
#macro ( mainMenu $menus )
    #foreach( $menu in $menus )
        #if ( $menu.name && $menu.items && $menu.items.size() > 0 )
        <nav class="card sidebar-menu" aria-label="$menu.name">
            <h3>$menu.name</h3>
            <ul class="sidebar-nav">
                #foreach( $item in $menu.items )
            #menuItem( $item )
            #end
            </ul>
        </nav>
        #end
    #end
#end

## "Last published / version" sidebar card — driven by site.xml's <publishDate/> and <version/>.
#macro ( publishVersionCard )
    #set ( $hasPublish = ( $decoration.publishDate && $decoration.publishDate.position && !$decoration.publishDate.position.equalsIgnoreCase(
        "none" ) ) )
    #set ( $hasVersion = ( $decoration.version && $decoration.version.position && !$decoration.version.position.equalsIgnoreCase(
        "none" ) ) )
    #if ( $hasPublish || $hasVersion )
        #if ( $publishDate )
            #set ( $renderedDate = $publishDate )
        #else
            #set ( $renderedDate = $date )
        #end
    <div class="card sidebar-meta">
        <h3>Project</h3>
        <ul class="list-compact">
            #if ( $hasVersion )
                <li><span class="muted">Version:</span> <span
                        id="projectVersion">${project.version}</span></li>
            #end
            #if ( $hasPublish )
                <li><span class="muted">Last published:</span> <span
                        id="publishDate">${renderedDate}</span></li>
            #end
        </ul>
    </div>
    #end
#end

