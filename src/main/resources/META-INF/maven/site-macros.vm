## "Powered by" footer logo. Falls back to the Maven feather if site.xml has no <poweredBy> entry.
#macro ( poweredByLogo $poweredBy )
    #if( $poweredBy && !$poweredBy.isEmpty() )
        #foreach ( $item in $poweredBy )
            #if( $item.href )
                #set ( $href = $PathTool.calculateLink( $item.href, $relativePath ).replaceAll(
                    '\\', '/' ) )
            #else
                #set ( $href = "https://maven.apache.org/" )
            #end
            #if( $item.name )
                #set ( $name = $item.name )
            #else
                #set ( $name = "Maven" )
            #end
            #if( $item.img )
                #set ( $img = $item.img )
            #else
                #set ( $img = "images/logos/maven-feather.png" )
            #end
            #if ( !$decoration.isLink( $img ) )
                #set ( $img = $PathTool.calculateLink( $img, $relativePath ).replaceAll(
                    '\\', '/' ) )
            #end
        <a class="poweredBy" href="$href" title="$name">
            <img src="$img" alt="$name"/>
        </a>
        #end
    #else
    <a class="poweredBy" href="https://maven.apache.org/"
       title="Built by Maven"><img
            src="$relativePath/images/logos/maven-feather.png"
            alt="Built by Maven"/></a>
    #end
#end

## Google Analytics — enabled via <custom><analytics><googleAnalyticsId>G-XXX</googleAnalyticsId></analytics></custom> in site.xml.
## Falls back to legacy <googleAnalyticsAccountId> in site.xml for back-compat.
#macro ( googleAnalytics )
    #set ( $analyticsEl = $decoration.custom.getChild( 'analytics' ) )
    #set ( $gaId = false )
    #if ( $analyticsEl )
        #set ( $gaIdEl = $analyticsEl.getChild( 'googleAnalyticsId' ) )
        #if ( $gaIdEl ) #set ( $gaId = $gaIdEl.getValue() ) #end
    #end
    #if ( !$gaId && $decoration.googleAnalyticsAccountId && $decoration.googleAnalyticsAccountId != "" )
        #set ( $gaId = $decoration.googleAnalyticsAccountId )
    #end
    #if ( $gaId )
    <!-- Google Analytics -->
    <script async
            src="https://www.googletagmanager.com/gtag/js?id=$gaId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());
        gtag('config', '$gaId');
    </script>
    #end
#end

## Ahrefs analytics — enabled via <custom><analytics><ahrefsKey>...</ahrefsKey></analytics></custom>.
#macro ( ahrefsAnalytics )
    #set ( $analyticsEl = $decoration.custom.getChild( 'analytics' ) )
    #if ( $analyticsEl )
        #set ( $ahrefsEl = $analyticsEl.getChild( 'ahrefsKey' ) )
        #if ( $ahrefsEl )
        <script async src="https://analytics.ahrefs.com/analytics.js"
                data-key="$ahrefsEl.getValue()"></script>
        #end
    #end
#end

## Diagram rendering scripts — Mermaid + Pako (for Kroki). Disable via
## <custom><diagrams><enabled>false</enabled></diagrams></custom> in site.xml.
## URLs can be overridden with <mermaidUrl>, <pakoUrl> children of <diagrams>.
#macro ( diagramScripts )
    #set ( $diagramsEnabled = true )
    #set ( $diagramsEl = $decoration.custom.getChild( 'diagrams' ) )
    #set ( $mermaidUrl =
        "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js" )
    #set ( $pakoUrl =
        "https://cdn.jsdelivr.net/npm/pako@2.1.0/dist/pako.min.js" )
    #if ( $diagramsEl )
        #set ( $enabledEl = $diagramsEl.getChild( 'enabled' ) )
        #if ( $enabledEl && $enabledEl.getValue() == "false" )
            #set ( $diagramsEnabled = false )
        #end
        #set ( $mUrl = $diagramsEl.getChild( 'mermaidUrl' ) )
        #if ( $mUrl ) #set ( $mermaidUrl = $mUrl.getValue() ) #end
        #set ( $pUrl = $diagramsEl.getChild( 'pakoUrl' ) )
        #if ( $pUrl ) #set ( $pakoUrl = $pUrl.getValue() ) #end
    #end
    #if ( $diagramsEnabled )
    <script defer src="$mermaidUrl"></script>
    <script defer src="$pakoUrl"></script>
    <script defer src="$relativePath/js/diagrams.js"></script>
    #end
#end

## Open Graph and Twitter Card tags
#macro ( openGraph )
    #if ( $project.name )
    <meta property="og:site_name" content="$project.name"/>
    #end
<meta property="og:title" content="$title"/>
<meta property="og:type" content="website"/>
    #if ( $cleanDesc )
    <meta property="og:description" content="$cleanDesc"/>
    #elseif ( $project.description )
        #set( $cleanDesc = $project.description.replaceAll(
            '[\r\n]+', ' ').replace('"', '').trim() )
    <meta property="og:description" content="$cleanDesc"/>
    #end
    #if ( $project.url )
    <meta property="og:url" content="$project.url/$alignedFileName"/>
    <link rel="canonical" href="$project.url/$alignedFileName"/>
    #end
    #set( $logoEl = $decoration.custom.getChild( 'logo' ) )
    #if( $logoEl )
        #set( $logoSrc = $logoEl.getValue() )
        #if( !$decoration.isLink( $logoSrc ) && $project.url )
            #set( $logoSrc = $project.url + "/" + $logoSrc )
        #end
    <meta property="og:image" content="$logoSrc"/>
    #end
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="$title"/>
    #if ( $cleanDesc )
    <meta name="twitter:description" content="$cleanDesc"/>
    #end
#end
